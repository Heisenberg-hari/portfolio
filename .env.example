DJANGO_SECRET_KEY=replace-with-a-strong-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.vercel.app
DJANGO_SECURE_SSL_REDIRECT=True

# Recommended for production (Neon/Supabase/Render Postgres URL)
# Example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
